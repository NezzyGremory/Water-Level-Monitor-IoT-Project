{
  "inputs": [
    {
      "type": "promptString",
      "id": "wokwi-cli-token",
      "description": "Wokwi CLI token (dari Wokwi CI Dashboard)",
      "password": true
    }
  ],
  "servers": {
    "Wokwi": {
      "type": "stdio",
      "command": "wokwi-cli",
      "args": ["mcp"],
      "env": {
        "WOKWI_CLI_TOKEN": "${input:wokwi-cli-token}"
      }
    }
  }
}
